# =====================================================================
# Ministry of Tribal Affairs (MoTA) Scholarship & Fellowship Portal
# Backend Environment Configuration
# =====================================================================

# Server Port (used during local node execution)
PORT=5000

# Runtime Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Ensure network access whitelist in Atlas includes 0.0.0.0/0 for Vercel dynamic IPs
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/scholarship?retryWrites=true&w=majority

# JWT Signing Secret (must be a strong, cryptographically random key in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (single origin or comma-separated list)
# Example for production: https://mota-scholarship-frontend.vercel.app,http://localhost:5173
CLIENT_URL=https://<your-frontend-project>.vercel.app

# Optional: Custom temporary directory for uploads (defaults to /tmp/uploads/documents on Vercel)
# UPLOAD_DIR=/tmp/uploads/documents
